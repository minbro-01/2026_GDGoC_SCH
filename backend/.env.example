PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gdgoc_sch

# JWT 서명 키 — 배포 시 반드시 무작위 값으로 교체
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Google AI Studio에서 발급 (무료 티어)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# AI 피드백은 선택 기능입니다. 점수는 항상 서버의 고정 루브릭으로 계산합니다.
AI_FEEDBACK_ENABLED=false
LLM_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 쉼표로 구분한 허용 프론트엔드 주소
CORS_ORIGINS=http://localhost:5173

# 모의투자(/api/sim) 시세는 업비트 공개 API를 키 없이 사용하며,
# 실패 시 서버 내 fixture 가격으로 자동 전환됩니다 — 추가 설정 불필요.

# AI 코치(/api/assistant)는 위 GEMINI_API_KEY를 그대로 사용합니다.
# 키가 없거나 Gemini 호출이 실패(timeout·quota 초과)하면 규칙 기반 피드백으로 대체됩니다.

# npm run prepare:demo — 이 계정의 모의투자 세션·AI 코치 대화 기록을 초기화합니다.
DEMO_ACCOUNT_EMAIL=
